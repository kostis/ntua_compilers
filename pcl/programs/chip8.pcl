program chip8_emulator;
    (*
        Chip-8 state:

        16 8-bit GPRs
        16-bit program counter
        16-bit index register
        8-bit delay and sound timers
        4KB of memory, which can optionally be extended for some chip-8 variants
        16 entry call stack
    *)
    var regs : array [16] of integer;
    var mem  : ^array of integer;
    var pc, index : integer;
    var delayTimer, soundTimer : integer;

    var stack : array [16] of integer;
    var sp : integer;

    (* Instructions per frame, default to 500 *)
    var ipf : integer;
    var rngSeed : integer;

    (* Screen is 64x32 on Chip-8, 128x64 on SUPER-CHIP. Allocate it as a char array that we will show on the terminal *)
    var screen : ^array of char;
    var screenWidth, screenHeight : integer;

    (* LUTs for implementing OR, AND, XOR since we don't have bitwise operations *)
    (* These LUTs calculate the operation on 4 bits at a time, with the bottom 4 bits of the LUT indexed by operand 1, and the top 4 bits indexed by the other operand *)
    var andLUT, orLUT, xorLUT : array [256] of integer;

    forward procedure loadFont();
    forward procedure initLUTs();
    forward procedure initScreen();
    forward procedure clearScreen();

    forward function getPixelIdx(x, y : integer) : integer;

    var instructionCount, frameCount : integer;
    var totalFrames : integer;
    var gameDrew    : boolean;

    (* Screen colours *)
    var whiteChar, blackChar : char;

    procedure init();
        var i : integer;
    begin
        (* Allocate 64KB for memory *)
        new [65536] mem;
        loadFont();
        initScreen();
        initLUTs();

        (* Set program counter to program start, ie 0x200, and clear most registers*)
        pc := 512;
        index := 0;
        delayTimer := 0;
        soundTimer := 0;
        sp := 0;
        rngSeed := 67;

        i := 15;
        while i >= 0 do
        begin
            regs[i] := 0;
            i := i - 1;
        end;

        frameCount := 0;
        totalFrames := 500;
        ipf := 50;
    end;

    procedure deinit();
    begin
        dispose [] mem;
        dispose [] screen;
    end;

    procedure loadFont();
    begin
        (* Font is loaded in memory somewhere in the first 0x200 bytes, but typically starting from address 0x50 *)
        mem^[80] := 240; mem^[81] := 144; mem^[82] := 144; mem^[83] := 144; mem^[84] := 240; mem^[85] := 32; mem^[86] := 96; mem^[87] := 32; mem^[88] := 32; mem^[89] := 112; mem^[90] := 240; mem^[91] := 16; mem^[92] := 240; mem^[93] := 128; mem^[94] := 240; mem^[95] := 240; mem^[96] := 16; mem^[97] := 240; mem^[98] := 16; mem^[99] := 240; mem^[100] := 144; mem^[101] := 144; mem^[102] := 240; mem^[103] := 16; mem^[104] := 16; mem^[105] := 240; mem^[106] := 128; mem^[107] := 240; mem^[108] := 16; mem^[109] := 240; mem^[110] := 240; mem^[111] := 128; mem^[112] := 240; mem^[113] := 144; mem^[114] := 240; mem^[115] := 240; mem^[116] := 16; mem^[117] :=32; mem^[118] := 64; mem^[119] := 64; mem^[120] := 240; mem^[121] := 144; mem^[122] := 240; mem^[123] := 144; mem^[124] := 240; mem^[125] := 240; mem^[126] := 144; mem^[127] := 240; mem^[128] := 16; mem^[129] := 240; mem^[130] := 240; mem^[131] := 144; mem^[132] := 240; mem^[133] := 144; mem^[134] := 144; mem^[135] := 224; mem^[136] := 144; mem^[137] := 224; mem^[138] := 144; mem^[139] := 224; mem^[140] := 240; mem^[141] := 128; mem^[142] := 128; mem^[143] := 128; mem^[144] := 240; mem^[145] := 224; mem^[146] := 144; mem^[147] := 144; mem^[148] := 144; mem^[149] := 224; mem^[150] := 240; mem^[151] := 128; mem^[152] := 240; mem^[153] := 128; mem^[154] := 240; mem^[155] := 240; mem^[156] := 128; mem^[157] := 240; mem^[158] := 128; mem^[159] := 128;
    end;

    procedure loadIBM();
    begin
        (* ROM is loaded starting from address 0x200 *)
        mem^[512] := 0; mem^[513] := 224; mem^[514] := 162; mem^[515] := 42; mem^[516] := 96; mem^[517] := 12; mem^[518] := 97; mem^[519] := 8; mem^[520] := 208; mem^[521] := 31; mem^[522] := 112; mem^[523] := 9; mem^[524] := 162; mem^[525] := 57; mem^[526] := 208; mem^[527] := 31; mem^[528] := 162; mem^[529] := 72; mem^[530] := 112; mem^[531] := 8; mem^[532] := 208; mem^[533] := 31; mem^[534] := 112; mem^[535] := 4; mem^[536] := 162; mem^[537] := 87; mem^[538] := 208; mem^[539] := 31; mem^[540] := 112; mem^[541] := 8; mem^[542] := 162; mem^[543] := 102; mem^[544] := 208; mem^[545] := 31; mem^[546] := 112; mem^[547] := 8; mem^[548] := 162; mem^[549] := 117; mem^[550] := 208; mem^[551] := 31; mem^[552] := 18; mem^[553] := 40; mem^[554] := 255; mem^[555] := 0; mem^[556] := 255; mem^[557] := 0; mem^[558] := 60; mem^[559] := 0; mem^[560] := 60; mem^[561] := 0; mem^[562] := 60; mem^[563] := 0; mem^[564] := 60; mem^[565] := 0; mem^[566] := 255; mem^[567] := 0; mem^[568] := 255; mem^[569] := 255; mem^[570] := 0; mem^[571] := 255; mem^[572] := 0; mem^[573] := 56; mem^[574] := 0; mem^[575] := 63; mem^[576] := 0; mem^[577] := 63; mem^[578] := 0; mem^[579] := 56; mem^[580] := 0; mem^[581] := 255; mem^[582] := 0; mem^[583] := 255; mem^[584] := 128; mem^[585] := 0; mem^[586] := 224; mem^[587] := 0; mem^[588] := 224; mem^[589] := 0; mem^[590] := 128; mem^[591] := 0; mem^[592] := 128; mem^[593] := 0; mem^[594] := 224; mem^[595] := 0; mem^[596] := 224; mem^[597] := 0; mem^[598] := 128; mem^[599] := 248; mem^[600] := 0; mem^[601] := 252; mem^[602] := 0; mem^[603] := 62; mem^[604] := 0; mem^[605] := 63; mem^[606] := 0; mem^[607] := 59; mem^[608] := 0; mem^[609] := 57; mem^[610] := 0; mem^[611] := 248; mem^[612] := 0; mem^[613] := 248; mem^[614] := 3; mem^[615] := 0; mem^[616] := 7; mem^[617] := 0; mem^[618] := 15; mem^[619] := 0; mem^[620] := 191; mem^[621] := 0; mem^[622] := 251; mem^[623] := 0; mem^[624] := 243; mem^[625] := 0; mem^[626] := 227; mem^[627] := 0; mem^[628] := 67; mem^[629] := 224; mem^[630] := 0; mem^[631] := 224; mem^[632] := 0; mem^[633] := 128; mem^[634] := 0; mem^[635] := 128; mem^[636] := 0; mem^[637] := 128; mem^[638] := 0; mem^[639] := 128; mem^[640] := 0; mem^[641] := 224; mem^[642] := 0; mem^[643] := 224;
    end;

    procedure loadPong();
    begin
        mem^[512] := 106; mem^[513] := 2; mem^[514] := 107; mem^[515] := 12; mem^[516] := 108; mem^[517] := 63; mem^[518] := 109; mem^[519] := 12; mem^[520] := 162; mem^[521] := 234; mem^[522] := 218; mem^[523] := 182; mem^[524] := 220; mem^[525] := 214; mem^[526] := 110; mem^[527] := 0; mem^[528] := 34; mem^[529] := 212; mem^[530] := 102; mem^[531] := 3; mem^[532] := 104; mem^[533] := 2; mem^[534] := 96; mem^[535] := 96; mem^[536] := 240; mem^[537] := 21; mem^[538] := 240; mem^[539] := 7; mem^[540] := 48; mem^[541] := 0; mem^[542] := 18; mem^[543] := 26; mem^[544] := 199; mem^[545] := 23; mem^[546] := 119; mem^[547] := 8; mem^[548] := 105; mem^[549] := 255; mem^[550] := 162; mem^[551] := 240; mem^[552] := 214; mem^[553] := 113; mem^[554] := 162; mem^[555] := 234; mem^[556] := 218; mem^[557] := 182; mem^[558] := 220; mem^[559] := 214; mem^[560] := 96; mem^[561] := 1; mem^[562] := 224; mem^[563] := 161; mem^[564] := 123; mem^[565] := 254; mem^[566] := 96; mem^[567] := 4; mem^[568] := 224; mem^[569] := 161; mem^[570] := 123; mem^[571] := 2; mem^[572] := 96; mem^[573] := 31; mem^[574] := 139; mem^[575] := 2; mem^[576] := 218; mem^[577] := 182; mem^[578] := 96; mem^[579] := 12; mem^[580] := 224; mem^[581] := 161; mem^[582] := 125; mem^[583] := 254; mem^[584] := 96; mem^[585] := 13; mem^[586] := 224; mem^[587] := 161; mem^[588] := 125; mem^[589] := 2; mem^[590] := 96; mem^[591] := 31; mem^[592] := 141; mem^[593] := 2; mem^[594] := 220; mem^[595] := 214; mem^[596] := 162; mem^[597] := 240; mem^[598] := 214; mem^[599] := 113; mem^[600] := 134; mem^[601] := 132; mem^[602] := 135; mem^[603] := 148; mem^[604] := 96; mem^[605] := 63; mem^[606] := 134; mem^[607] := 2; mem^[608] := 97; mem^[609] := 31; mem^[610] := 135; mem^[611] := 18; mem^[612] := 70; mem^[613] := 2; mem^[614] := 18; mem^[615] := 120; mem^[616] := 70; mem^[617] := 63; mem^[618] := 18; mem^[619] := 130; mem^[620] := 71; mem^[621] := 31; mem^[622] := 105; mem^[623] := 255; mem^[624] := 71; mem^[625] := 0; mem^[6