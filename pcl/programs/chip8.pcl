    end;

    (* Clear line by line to avoid clearing the newline characters at the end of each line *)
    procedure clearScreen();
        var x, y, idx : integer;
    begin
        y := 0;
        idx := 0;
        gameDrew := true;

        while y < screenHeight do begin
            x := 0;

            while x < screenWidth do begin
                screen^[idx] := whiteChar;
                x := x + 1;
                idx := idx + 1;
            end;

            y := y + 1;
            idx := idx + 1; (* Skip newline character *)
        end;
    end;

    (* Initialize newlines and null terminator in screen array *)
    procedure initScreen();
        var y, idx, stride : integer;
    begin
        (* Assume regular Chip-8 for now. *)
        (* Since we're storing the string as a printable C string, we need to allocate 1 extra character at the end of each pixel row for the newline character *)
        (* Or for the null terminator, in the case of the final row *)
        (* So screenHeight extra bytes total *)
        screenWidth  := 64;
        screenHeight := 32;
        new [screenWidth * screenHeight + screenHeight] screen;

        whiteChar := ' ';
        blackChar := '@';

        y := 0;
        stride := screenWidth + 1;

        while y < screenHeight do begin
            idx := y * stride + screenWidth;

            if y < screenHeight-1 then begin
                screen^[idx] := '\n'
            end

            else begin
                screen^[idx] := '\0'
            end;

            y := y + 1;
        end;

        clearScreen();
    end;

    procedure pushPC();
    begin
        stack[sp] := pc;
        sp := sp + 1;
    end;

    procedure popPC();
    begin
        sp := sp - 1;
        pc := stack[sp];
    end;

    (* Store all registers v0 ...= vx starting from the address index register points to*)
    procedure storeUntil(x : integer);
        var i : integer;
    begin
        i := 0;

        while i <= x do begin
            mem^[index + i] := regs[i];
            i := i + 1;
        end;
    end;

    procedure loadUntil(x : integer);
        var i : integer;
    begin
        i := 0;

        while i <= x do begin
            regs[i] := mem^[index + i];
            i := i + 1;
        end;
    end;

    (* Read 16-bit big-endian value from memory *)
    function readU16(addr : integer) : integer;
        var low, high : integer;
    begin
        high := mem^[addr];
        low  := mem^[addr + 1];

        (* return low | (high << 8) *)
        result := low + (high * 256);
    end;

    (* Truncate value to 8 bits by doing & 0xFF *)
    function u8(val : integer) : integer;
    begin
        result := val mod 256;
    end;

    (* Truncate value to 16 bits by doing & 0xFFFF *)
    function u16(val : integer) : integer;
    begin
        result := val mod 65536;
    end;

    (* Get top nibble of 16-bit opcode *)
    function getTopNibble(val : integer) : integer;
    begin
        (* (val >> 12) & 0xF *)
        result := (val div 4096) mod 16;
    end;

    (* Helpers for emulating bitwise operations by a constant, since we don't have bitwise ops *)
    (* AND by constant becomes modulo, SHR by constant becomes div, SHL becomes mul*)
    function andF(val : integer) : integer;
    begin
        result := val mod 16;
    end;

    function andFFF(val : integer) : integer;
    begin
        result := val mod 4096;
    end;

    function shr4(val : integer) : integer;
    begin
        result := val div 16;
    end;

    function shr8(val : integer) : integer;
    begin
        result := val div 256;
    end;

    (* LUT-based helpers for emulating bitwise operations between 2 variables, using LUTs, 4 bits at a time *)
    function calcAND(a, b : integer) : integer;
        var resLow, resHigh : integer;
    begin
        resLow  := andLUT[andF(a) + andF(b) * 16];             (* resLow = andLUT[(a & 0xF) | ((b & 0xF) << 4) *)
        resHigh := andLUT[andF(shr4(a)) + andF(shr4(b)) * 16]; (* resHigh = andLUT[((a >> 4) & 0xF) | (((b >> 4) & 0xF) << 4) *)
        result  := resLow + resHigh * 16;                      (* result = resLow | (resHigh << 16) *)
    end;

    function calcOR(a, b : integer) : integer;
        var resLow, resHigh : integer;
    begin
        resLow  := orLUT[andF(a) + andF(b) * 16];
        resHigh := orLUT[andF(shr4(a)) + andF(shr4(b)) * 16];
        result  := resLow + resHigh * 16;
    end;

    function calcXOR(a, b : integer) : integer;
        var resLow, resHigh : integer;
    begin
        resLow  := xorLUT[andF(a) + andF(b) * 16];
        resHigh := xorLUT[andF(shr4(a)) + andF(shr4(b)) * 16];
        result  := resLow + resHigh * 16;
    end;

    (* Subtract a-b, return the 8-bit result and carry out *)
    (* If the number becomes negative, properly fix it up *)
    (* We consider cout = 1 if the result DOES NOT become negative, ie if there's no borrow *)
    function calcSub(a, b : integer; var cout : boolean) : integer;
        var tmp : integer;
    begin
        (* tmp = (a - b) unsigned mod 256*)
        tmp := a - b;
        if tmp < 0 then begin
            tmp := tmp + 256;
            cout := false;
        end

        else begin
            cout := true;
        end;

        result := tmp;
    end;

    procedure printInt(x : integer);
    begin
        writeInteger(x);
        writeChar('\n');
    end;

    function getPixelIdx(x, y : integer) : integer;
    begin
        (* Account for the 1 extra newline character at the end of each row of pixels *)
        result := y * (screenWidth + 1) + x;
    end;

    procedure aluInstruction(opcode : integer);
        var x, y, subopcode : integer;
        var subCout : boolean;
    begin
        x := andF(shr8(opcode));
        y := andF(shr4(opcode));
        subopcode := andF(opcode);

        (* vx = vy *)
        if subopcode = 0 then begin
            regs[x] := regs[y];
        end

        (* vx |= vy *)
        else if subopcode = 1 then begin
            regs[x] := calcOR(regs[x], regs[y]);
        end

        (* vx |= vy *)
        else if subopcode = 2 then begin
            regs[x] := calcAND(regs[x], regs[y]);
        end

        (* vx ^= vy *)
        else if subopcode = 3 then begin
            regs[x] := calcXOR(regs[x], regs[y]);
        end

        (* vx += vy *)
        else if subopcode = 4 then begin
            regs[x] := regs[x] + regs[y];

            if (regs[x] >= 256) then begin
                regs[x] := u8(regs[x]);
                regs[15] := 1; (* Carry = 1*)
            end
            
            else begin
                regs[15] := 0;
            end;
        end

        (* vx -= vy *)
        else if subopcode = 5 then begin
            regs[x] := calcSub(regs[x], regs[y], subCout);

            if subCout then
                regs[15] := 1
            else
                regs[15] := 0
        end

        (* vy -= vx *)
        else if subopcode = 7 then begin
            regs[y] := calcSub(regs[y], regs[x], subCout);
            
            if subCout then
                regs[15] := 1
            else
                regs[15] := 0
        end

        else begin
            writeString("Unimplemented 8XYN instruction: ");
            printInt(opcode);
        end;
    end;

    (* FXNN instructions *)
    procedure FXNNInstruction(opcode : integer);
        var x, subopcode : integer;
    begin
        x := andF(shr8(opcode));
        subopcode := u8(opcode);

        (* FX15: vx = delay timer *)
        if subopcode = 7 then begin
            regs[x] := delayTimer;
        end

        (* FX15: delay timer = vx *)
        else if subopcode = 21 then begin
            delayTimer := regs[x];
        end

        (* FX18: sound timer = vx *)
        else if subopcode = 24 then begin
            soundTimer := regs[x];
        end

        (* FX1E: index += vx *)
        else if subopcode = 30 then begin
            index := u16(index + regs[x]);
        end

        (* FX29: Set index to font character address *)
        else if subopcode = 41 then begin
            index := u16(80 + regs[x] * 5); (* Each character sprite is 5 bytes *)
        end

        (* FX33: BCD conversion *)
        else if subopcode = 51 then begin
            mem^[index + 0] := (regs[x] div 100) mod 10; (* Hundreds *)
            mem^[index + 1] := (regs[x] div 10) mod 10;  (* Tens *)
            mem^[index + 2] := regs[x] mod 10;           (* Ones *)
        end

        (* FX55: Store regs 0...=vx *)
        else if subopcode = 85 then begin
            storeUntil(x);
        end

        (* FX65: Load regs 0...=vx *)
        else if subopcode = 101 then begin
            loadUntil(x);
        end

        else begin
            writeString("Unimplemented FXNN instruction: ");
            printInt(opcode);
        end;
    end;
    
    procedure skipIfKeyInstruction(opcode : integer);
        var x, subopcode : integer;
    begin
        x := andF(shr8(opcode));
        subopcode := u8(opcode);

        (* EX9E: Skip if key pressed (stubbed to nop) *)
        if subopcode = 158 then begin
        end

        (* EXA1: Skip if key not pressed (stubbed to always skip) *)
        else if subopcode = 161 then begin
            pc := pc + 2;
        end

        else begin
            writeString("Unimplemented 8XYN instruction: ");
            printInt(opcode);
        end;
    end;

    (* glibc LCG: https://en.wikipedia.org/wiki/Linear_congruential_generator#Parameters_in_common_use *)
    (* Skipping the mod because we're only keeping the bottom 8 bits regardless *)
    function generateRandom() : integer;
    begin
        rngSeed := (1103515245 * rngSeed) + 12345;
        result := rngSeed;
    end;

    (* Temporaries for main loop *)
    var opcode : integer;
    var topNibble : integer;

    var sprite : integer;
    var col, row : integer;
    var vx, vy, dxyn_n : integer;
    var pixelX, pixelY, pixelIdx, bit : integer;

    var currentGame    : integer;
    var selectedGame   : boolean;
begin
    init();

    selectedGame := false;

    while not selectedGame do
    begin
        writeString("Select a game to play:\n");
        writeString("    1. Space Invaders\n");
        writeString("    2. Pong\n");
        writeString("    3. IBM Logo\n");

        currentGame  := readInteger();
        selectedGame := true;

        if currentGame = 1 then begin
            loadInvaders();
        end

        else if currentGame = 2 then begin
            loadPong();
        end

        else if currentGame = 3 then begin
            loadIBM();
        end

        else begin
            writeString("This is not a valid game >:(\n");
            selectedGame := false;
        end
    end;

    while frameCount < totalFrames do
    begin
        instructionCount := 0;
        gameDrew := false;

        while instructionCount < ipf do
        begin
            (* Read opcode from memory, decode it and execute it *)
            opcode := readU16(pc);
            pc := u16(pc + 2);

            topNibble := getTopNibble(opcode);
            
            (* 0NNN: Execute assembly routine *)
            (* If NNN = 0xE0, this is the clear screen routine *)
            (* If NNN = 0xEE, this is a return instruction *)
            (* Otherwise, the game is trying to call some other assembly routine which we don't support *)
            if topNibble = 0 then begin
                if andFFF(opcode) = 224 then begin
                    clearScreen();
                end

                else if andFFF(opcode) = 238 then begin
                    popPC();
                end

                else begin
                    writeString("Unimplemented assembly routine in 0NNN instruction: ");
                    printInt(andFFF(opcode));
                    return;
                end;
            end

            (* 1NNN: Jump *)
            else if topNibble = 1 then begin
                pc := andFFF(opcode);
            end

            (* 2NNN: Call subroutine *)
            else if topNibble = 2 then begin
                pushPC();
                pc := andFFF(opcode);
            end

            (* 3NNN: Skip next instruction if vx == NN *)
            else if topNibble = 3 then begin
                if regs[andF(shr8(opcode))] = u8(opcode) then
                    pc := u16(pc + 2);
            end

            (* 4NNN: Skip next instruction if vx != NN *)
            else if topNibble = 4 then begin
                if regs[andF(shr8(opcode))] <> u8(opcode) then
                    pc := u16(pc + 2);
            end

            (* 6XNN: Set register VX *)
            else if topNibble = 6 then begin
                regs[andF(shr8(opcode))] := u8(opcode);
            end

            (* 7XNN: Add value to register VX *)
            else if topNibble = 7 then begin
                regs[andF(shr8(opcode))] := u8(regs[andF(shr8(opcode))] + u8(opcode));
            end

            (* 8XYN: ALU ops *)
            else if topNibble = 8 then begin
                aluInstruction(opcode);
            end

            (* ANNN: Set index register *)
            else if topNibble = 10 then begin
                index := andFFF(opcode);
            end

            (* CNNN: RAND *)
            else if topNibble = 12 then begin
                regs[andF(shr8(opcode))] := generateRandom();
            end

            (* DXYN: Draw sprite *)
            else if topNibble = 13 then begin
                vx := regs[andF(shr8(opcode))];
                vy := regs[andF(shr4(opcode))];
                dxyn_n := andF(opcode);
                gameDrew := true;

                (* Set collision flag in VF to 0 initially *)
                regs[15] := 0;

                (* Draw sprite line-by-line *)
                row := 0;

                while row < dxyn_n do begin
                    sprite := mem^[index + row]; (* 1 row of the sprite *)
                    col := 0;

                    while col < 8 do begin
                        (* Bit = (sprite >> 7) & 1; sprite <<= 1; *)
                        bit := sprite div 128;
                        sprite := (sprite mod 128) * 2;

                        if bit = 1 then begin
                            (* Pixel coordinates, wrapping if we go over an edge *)
                            pixelX := (vx + col) mod screenWidth;
                            pixelY := (vy + row) mod screenHeight;
                            pixelIdx := getPixelIdx(pixelX, pixelY);

                            (* xor pixel on the screen with 1 *)
                            (* If pixel was already set, then we've got a collision, so set vf to 1 *)
                            if screen^[pixelIdx] = whiteChar then begin
                                screen^[pixelIdx] := blackChar;
                            end

                            else begin
                                screen^[pixelIdx] := whiteChar;
                                regs[15] := 1;
                            end;
                        end;

                        col := col + 1;
                    end;

                    row := row + 1;
                end;
            end

            (* EXNN: Skip if key is (not) pressed *)
            else if topNibble = 14 then begin
                skipIfKeyInstruction(opcode);
            end

            (* FXNN: Timer & misc hardware manipulation instructions *)
            else if topNibble = 15 then begin
                FXNNInstruction(opcode);
            end

            else begin
                writeString("Unimplemented opcode: ");
                printInt(opcode);
                return;
            end;

            instructionCount := instructionCount + 1;
        end;

        (* Timers count down at 60Hz, ie once per frame on hardware *)
        (* The original Chip-8 interpreter actually did the countdowns inside the vblank irq handler *)
        if delayTimer > 0 then
            delayTimer := delayTimer - 1;

        if soundTimer > 0 then
            soundTimer := soundTimer - 1;
        
        if gameDrew then
            writeString(screen^);

        frameCount := frameCount + 1;
    end;

    deinit();
end.
